{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": "vite",
  "functions": { "api/market.js": { "maxDuration": 60 }, "api/events.js": { "maxDuration": 30 } },
  "headers": [
    { "source": "/data/market.json", "headers": [{ "key": "Cache-Control", "value": "no-store, max-age=0" }] }
  ]
}
